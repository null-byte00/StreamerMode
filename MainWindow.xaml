<Window x:Class="StreamerMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamerMode" Width="560" Height="620" MinWidth="480" MinHeight="420"
        Background="#16161e" Foreground="#e6e6ef" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#23232e"/>
            <Setter Property="Foreground" Value="#e6e6ef"/>
            <Setter Property="BorderBrush" Value="#3a3a4a"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#23232e"/>
            <Setter Property="Foreground" Value="#e6e6ef"/>
            <Setter Property="BorderBrush" Value="#3a3a4a"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e6e6ef"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#23232e"/>
            <Setter Property="Foreground" Value="#e6e6ef"/>
            <Setter Property="BorderBrush" Value="#3a3a4a"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#e6e6ef"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="14">

        <!-- Шапка: мастер-режим -->
        <Border DockPanel.Dock="Top" Background="#1e1e28" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="Стример-режим" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ModeStatus" Text="выкл — всё видно в записи" Foreground="#8a8a9a" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="ModeToggle" Content="ВКЛ" Width="70" HorizontalAlignment="Right"
                                  Checked="ModeToggle_Checked" Unchecked="ModeToggle_Unchecked"/>
                </DockPanel>
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Text="Хоткей:" VerticalAlignment="Center"/>
                    <TextBox x:Name="HotkeyBox" Width="140" Margin="8,0" LostFocus="HotkeyBox_LostFocus"
                             ToolTip="Кликни и зажми комбинацию"/>
                    <TextBlock Text="— тоглит режим отовсюду" Foreground="#8a8a9a" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock x:Name="UpdateStatus" Text="" Foreground="#8a8a9a" VerticalAlignment="Center"/>
                    <Button x:Name="UpdateBtn" Content="Обновить" Visibility="Collapsed" Click="Update_Click"
                            HorizontalAlignment="Right" Padding="14,4"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Низ: автозапуск + обновить -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="AutostartBox" Content="Запускать с Windows" VerticalAlignment="Center"
                      Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
            <Button Content="Обновить список" Click="Refresh_Click" HorizontalAlignment="Right"/>
        </DockPanel>

        <!-- Сохранённые правила -->
        <Border DockPanel.Dock="Bottom" Background="#1e1e28" CornerRadius="8" Padding="10" Margin="0,10,0,0" MaxHeight="130">
            <DockPanel>
                <TextBlock Text="Правила (работают даже когда окно переоткрыто)" DockPanel.Dock="Top"
                           Foreground="#8a8a9a" Margin="0,0,0,6"/>
                <ScrollViewer>
                    <ItemsControl x:Name="RulesList"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Список окон -->
        <Border Background="#1e1e28" CornerRadius="8" Padding="10">
            <DockPanel>
                <TextBlock Text="Открытые окна" DockPanel.Dock="Top" Foreground="#8a8a9a" Margin="0,0,0,6"/>
                <ScrollViewer>
                    <ItemsControl x:Name="WinList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#2c2c3a" BorderThickness="0,0,0,1" Padding="0,6">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left" Width="250">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"/>
                                            <TextBlock Text="{Binding Proc}" Foreground="#8a8a9a" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox Content="весь процесс" Margin="8,0" VerticalAlignment="Center"
                                                  IsChecked="{Binding WholeProc}" Click="WholeProc_Click"
                                                  ToolTip="Скрывать любое окно этого процесса"/>
                                        <ComboBox Width="110" HorizontalAlignment="Right" SelectedIndex="{Binding ModeIndex}"
                                                  SelectionChanged="Mode_Changed" Tag="{Binding}">
                                            <ComboBoxItem Content="—"/>
                                            <ComboBoxItem Content="По режиму"/>
                                            <ComboBoxItem Content="Всегда"/>
                                        </ComboBox>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
