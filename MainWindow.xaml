<Window x:Class="StreamerMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StreamerMode" Width="720" Height="560" MinWidth="600" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#FF1B1B1B"/>
        <SolidColorBrush x:Key="Card" Color="#FF2B2B2B"/>
        <SolidColorBrush x:Key="Control" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="ControlHover" Color="#FF454545"/>
        <SolidColorBrush x:Key="Divider" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="Txt" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="Txt2" Color="#FFC5C5C5"/>
        <SolidColorBrush x:Key="Txt3" Color="#FF8A8A8A"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4CC2FF"/>
        <SolidColorBrush x:Key="AccentDark" Color="#FF0078D4"/>
        <SolidColorBrush x:Key="Red" Color="#FFE81123"/>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="44"/><Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" Height="24" CornerRadius="12" Background="{StaticResource Control}"
                                    BorderBrush="{StaticResource Divider}" BorderThickness="1"/>
                            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource Txt2}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentDark}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentDark}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Txt}"/>
            <Setter Property="Background" Value="{StaticResource Control}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ControlHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="10" BorderBrush="{StaticResource Divider}" BorderThickness="1">
        <DockPanel Margin="12">

            <!-- Тайтлбар -->
            <DockPanel DockPanel.Dock="Top" Margin="-12,0,-12,10" Height="34" x:Name="TitleBar">
                <Border Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                    <DockPanel>
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="16,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="StreamerMode" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource Txt}"/>
                    </DockPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconBtn}" Content="—" Click="Min_Click"/>
                    <Button Style="{StaticResource IconBtn}" Content="✕" Click="Close_Click" Margin="0,0,6,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Шапка -->
            <Border DockPanel.Dock="Top" Background="{StaticResource Card}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <StackPanel>
                            <TextBlock Text="Стример-режим" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Txt}"/>
                            <TextBlock x:Name="ModeStatus" Text="" Foreground="{StaticResource Txt3}" Margin="0,2,0,0" FontSize="11"/>
                        </StackPanel>
                        <ToggleButton x:Name="ModeToggle" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Checked="ModeToggle_Checked" Unchecked="ModeToggle_Unchecked"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Хоткей режима" VerticalAlignment="Center" Foreground="{StaticResource Txt2}" FontSize="11"/>
                        <TextBox x:Name="HotkeyBox" Width="110" Margin="8,0,12,0" VerticalAlignment="Center"
                                 Background="{StaticResource Control}" Foreground="{StaticResource Txt}" BorderThickness="0"
                                 Padding="8,4" IsReadOnly="True" Cursor="Hand" FontSize="11"
                                 GotFocus="Hotkey_GotFocus" LostFocus="HotkeyBox_LostFocus"/>
                        <TextBlock x:Name="UpdateStatus" Text="" Foreground="{StaticResource Txt3}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="UpdateBtn" Style="{StaticResource FlatBtn}" Content="Обновить"
                                Visibility="Collapsed" Click="Update_Click" HorizontalAlignment="Right"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Низ -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <CheckBox x:Name="AutostartBox" Content="С Windows" VerticalAlignment="Center"
                          Foreground="{StaticResource Txt2}" FontSize="11"
                          Checked="Autostart_Changed" Unchecked="Autostart_Changed"/>
                <TextBlock Text="клик по «hide» — окно уходит в список слева" Foreground="{StaticResource Txt3}"
                           FontSize="10" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button Style="{StaticResource FlatBtn}" Content="Обновить" Click="Refresh_Click" HorizontalAlignment="Right"/>
            </DockPanel>

            <!-- Два столбца -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВО: приложения/правила -->
                <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                    <DockPanel>
                        <TextBlock Text="Приложения" DockPanel.Dock="Top" Foreground="{StaticResource Txt3}"
                                   FontSize="11" Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <ItemsControl x:Name="RulesList"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- ПРАВО: открытые окна -->
                <Border Grid.Column="1" Background="{StaticResource Card}" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                    <DockPanel>
                        <TextBlock Text="Окна" DockPanel.Dock="Top" Foreground="{StaticResource Txt3}"
                                   FontSize="11" Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <ItemsControl x:Name="WinList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,4">
                                            <Button Content="hide" Style="{StaticResource FlatBtn}" Width="52"
                                                    Click="Hide_Click" Tag="{Binding}" HorizontalAlignment="Right"/>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource Txt}" FontSize="12" ToolTip="{Binding Title}"/>
                                                <TextBlock Text="{Binding Proc}" Foreground="{StaticResource Txt3}" FontSize="10"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
